# ==============================================================================
# STAR Travels Platform - Master Environment Template (.env.example)
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE BACKEND & CLOUD INFRASTRUCTURE (Neon PostgreSQL + Upstash Redis)
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-secret-key-change-in-production-64-characters-long
# 1 = Local Dev (hiển thị chi tiết lỗi); 0 = Production trên Render
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api,host.docker.internal,startravels.vn,api.startravels.vn,*.koyeb.app,*.vercel.app,*.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://startravels.vn,https://api.startravels.vn,https://*.vercel.app,https://*.koyeb.app,https://*.onrender.com
DJANGO_LOG_LEVEL=INFO

# Database chính: Neon PostgreSQL Serverless (hoặc Postgres URL bất kỳ)
DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cache & Message Broker: Upstash Redis (hoặc Redis URL bất kỳ)
REDIS_URL=rediss://default:your-token@wise-boxer.upstash.io:6379

# Celery: Bật 1 trên Render Free Tier để xử lý task đồng bộ, không tốn thêm container worker
CELERY_TASK_ALWAYS_EAGER=1

# ------------------------------------------------------------------------------
# 2. VIETQR PAYMENT GATEWAY (Đồng bộ cả Backend & Frontend)
# ------------------------------------------------------------------------------
# Backend: Dùng khi API tạo chuỗi EMVCo và đường link thanh toán QR động
VIETQR_BANK_BIN=970422
VIETQR_BANK_NAME=MBBank
VIETQR_ACCOUNT_NO=0000000000
VIETQR_ACCOUNT_NAME=CONG TY TNHH STAR TRAVELS VIET NAM
VIETQR_TEMPLATE=compact2

# Frontend: Đồng bộ sang Next.js App Router (apps/public-site)
NEXT_PUBLIC_VIETQR_BANK_BIN=970422
NEXT_PUBLIC_VIETQR_BANK_NAME=MBBank
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=0000000000
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=CONG TY TNHH STAR TRAVELS VIET NAM

# ------------------------------------------------------------------------------
# 3. FRONTEND NEXT.JS & PUBLIC SITE
# ------------------------------------------------------------------------------
# URL gọi API Backend (Local: http://localhost:8000/api/v1 | Prod: https://website-traveling.onrender.com/api/v1)
BACKEND_URL=http://localhost:8000/api/v1
# Domain Frontend (Local: http://localhost:3000 | Prod: https://website-traveling.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_LOCAL_ANIMA_ASSETS=0
BFF_ASSISTANT_TIMEOUT_MS=25000

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE (Lưu trữ hình ảnh đám mây)
# ------------------------------------------------------------------------------
# Quản lý media tại: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ------------------------------------------------------------------------------
# 5. AI CONCIERGE & RAG ASSISTANT (Google Gemini) -> [TÙY CHỌN]
# ------------------------------------------------------------------------------
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# Chỉ cần 1 dòng này, hệ thống sẽ tự động cấu hình Model và Endpoint cho AI Assistant
GEMINI_API_KEY=
# Nếu dùng OpenAI thay thế Gemini:
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. DOANH NGHIỆP ODOO 18 ERP & GIÁM SÁT SENTRY -> [TÙY CHỌN]
# ------------------------------------------------------------------------------
ODOO_BASE_URL=http://localhost:8069
ODOO_WEBHOOK_SECRET=your_odoo_webhook_secret_here
ODOO_INBOUND_API_KEY=your_odoo_inbound_api_key_here

# Sentry APM (theo dõi log lỗi production - để trống nếu chưa dùng)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
