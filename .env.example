# ==============================================================================
# STAR Travels Platform - Example Environment Configuration (.env.example)
# Copy this file to .env at the root of the repository: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace_with_strong_django_secret_key_64_chars
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api,host.docker.internal,startravels.vn,api.startravels.vn
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://startravels.vn,https://api.startravels.vn
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. PostgreSQL & PostGIS Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_DB_ENGINE=django.contrib.gis.db.backends.postgis

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Worker Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Rate Limiting (DRF Throttling)
# ------------------------------------------------------------------------------
DRF_THROTTLE_ANON=200/day
DRF_THROTTLE_USER=2000/day
DRF_THROTTLE_AUTH=10/minute
DRF_THROTTLE_PAYMENT=30/minute
DRF_THROTTLE_ASSISTANT_CHAT_ANON=15/minute
DRF_THROTTLE_ASSISTANT_CHAT_USER=30/minute

# ------------------------------------------------------------------------------
# 5. Frontend & Next.js App Router Settings
# ------------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_LOCAL_ANIMA_ASSETS=0
BFF_ASSISTANT_TIMEOUT_MS=25000
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
NEXT_OUTPUT_STANDALONE=0

# ------------------------------------------------------------------------------
# 6. Odoo 18 ERP Integration (HMAC Signature & Inbound Authentication)
# ------------------------------------------------------------------------------
ODOO_BASE_URL=http://localhost:8069
ODOO_WEBHOOK_SECRET=replace_with_strong_odoo_webhook_secret_key_64chars
ODOO_INBOUND_API_KEY=replace_with_strong_odoo_inbound_token

# ------------------------------------------------------------------------------
# 7. VietQR Payment Gateway (NAPAS 247 Standard - Backend & Frontend)
# ------------------------------------------------------------------------------
VIETQR_BANK_BIN=970422
VIETQR_BANK_NAME=MBBank
VIETQR_ACCOUNT_NO=0000000000
VIETQR_ACCOUNT_NAME=CONG TY TNHH STAR TRAVELS VIET NAM
VIETQR_TEMPLATE=compact2

NEXT_PUBLIC_VIETQR_BANK_BIN=970422
NEXT_PUBLIC_VIETQR_BANK_NAME=MBBank
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=0000000000
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=CONG TY TNHH STAR TRAVELS VIET NAM

# ------------------------------------------------------------------------------
# 8. Application Performance Monitoring (Sentry APM) & Alerting
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
ALERT_WEBHOOK_URL=https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
SENTRY_ORG=star-travels
SENTRY_PROJECT=travel-platform
SENTRY_AUTH_TOKEN=replace_with_sentry_auth_token
RELEASE_VERSION=star-travels-api@1.0.0

# ------------------------------------------------------------------------------
# 9. Analytics & SEO Web Verification
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-token

# ------------------------------------------------------------------------------
# 10. Jev Runtime Intent Router (Phase 3 Pilot)
# ------------------------------------------------------------------------------
JEV_ROUTER_ENABLED=0
JEV_API_KEY=your_jev_api_key_here
JEV_API_ENDPOINT=https://api.jev.ai/v1/choice
JEV_TIMEOUT_SECONDS=2.0

# ------------------------------------------------------------------------------
# 11. Jev RAG Evidence Gate & LLM Integration
# ------------------------------------------------------------------------------
# Arch Note: Multi-Vendor Data Egress:
# - Embedding: OpenAI text-embedding-3-small (1536 dims).
# - Judge/Gating: TypeSafe System One (Score + Noul questions).
# - Chat Synthesis: Google Gemini Flash pinned version (gemini-1.5-flash-002).
# If switching embedding vendor to Gemini text-embedding-004 (768 dims) or local
# BGE-M3 (1024 dims), run migration for assistant_rag_vector_chunk and re-embed
# via: python manage.py index_jev_rag --reindex-all
JEV_EVIDENCE_ENABLED=0
TYPESAFE_API_KEY=your_typesafe_api_key_here
RAG_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
RAG_EMBEDDING_API_KEY=your_openai_or_compatible_api_key
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_CHAT_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
RAG_CHAT_API_KEY=your_chat_llm_api_key
# Ghim phien ban cu the cho Production (tuyet doi khong dung alias 'latest'):
RAG_CHAT_MODEL=gemini-1.5-flash-002

# Active Gemini Flash API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

