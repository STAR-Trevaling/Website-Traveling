# Django Core Settings
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,startravels.vn,api.startravels.vn
DJANGO_CSRF_TRUSTED_ORIGINS=https://startravels.vn,https://api.startravels.vn

# PostgreSQL Database Configuration
POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Cache & Celery Broker
REDIS_URL=redis://redis:6379/0

# Rate Limiting (DRF Throttling)
DRF_THROTTLE_ANON=200/day
DRF_THROTTLE_USER=2000/day
DRF_THROTTLE_AUTH=10/minute
DRF_THROTTLE_PAYMENT=30/minute

# Frontend & Next.js Public Settings
NEXT_PUBLIC_SITE_URL=https://startravels.vn
BACKEND_URL=http://backend:8000/api/v1

# Odoo 18 ERP Integration
ODOO_BASE_URL=http://host.docker.internal:8069
ODOO_WEBHOOK_SECRET=replace_with_strong_odoo_webhook_secret_key_64chars
ODOO_INBOUND_API_KEY=replace_with_strong_odoo_inbound_token

# VNPay Payment Gateway (Sandbox or Production)
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=DEMO_TMN
VNPAY_HASH_SECRET=replace_with_production_vnpay_hash_secret_key
VNPAY_RETURN_URL=https://startravels.vn/payment/return

# VietQR Payment Gateway (NAPAS 247 Standard)
VIETQR_BANK_BIN=970422
VIETQR_BANK_NAME=MBBank
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME=CONG TY TNHH STAR TRAVELS VIET NAM
VIETQR_TEMPLATE=compact2
