# ==============================================================================
# STAR Travels Platform - Master Environment Configuration (.env.example)
# Single Source of Truth for Monorepo (apps/api, apps/public-site, docker-compose)
# Copy this file to .env at the root of the repository: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Core Settings
# ------------------------------------------------------------------------------
# Khóa bí mật Django (đã tạo sẵn khóa 64 ký tự ngẫu nhiên an toàn, có thể đổi tùy ý)
DJANGO_SECRET_KEY=8NDj-YUh2hUpMmJkVnutijChqWAlEcY4UOPOdKU1tAdQPQ_d4JBNQOJKg6ATzG6ihr0
# 1 = Bật chế độ Debug cho dev; 0 = Chế độ Production bảo mật
DJANGO_DEBUG=1
# Danh sách domain được phép gọi API (đã bao gồm sẵn Koyeb, Vercel, Render)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api,host.docker.internal,startravels.vn,api.startravels.vn,*.koyeb.app,*.vercel.app,*.onrender.com
# Danh sách origin được tin cậy CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://startravels.vn,https://api.startravels.vn,https://*.vercel.app,https://*.koyeb.app,https://*.onrender.com
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database Configuration (Hỗ trợ cả 2 cách: Cloud URL hoặc Local Docker)
# ------------------------------------------------------------------------------
# CÁCH A: Nếu dùng Cloud Database (Neon.tech, Supabase, Render Postgres), dán URL vào đây:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# CÁCH B: Nếu dùng Docker Compose hoặc Localhost, điền thông số dưới đây:
POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_DB_ENGINE=django.contrib.gis.db.backends.postgis

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Task Broker
# ------------------------------------------------------------------------------
# Local Docker: redis://localhost:6379/0 (hoặc redis://redis:6379/0 trong docker-compose)
# Cloud Free (Upstash): rediss://default:YOUR_UPSTASH_TOKEN@xyz.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Bật 1 nếu deploy gói Free 1 container (tác vụ chạy đồng bộ không cần worker riêng)
CELERY_TASK_ALWAYS_EAGER=0
# Bật 1 nếu muốn start.sh tự động chạy worker ngầm trong cùng 1 container
RUN_CELERY_IN_BACKGROUND=0

# ------------------------------------------------------------------------------
# 4. AI & RAG Concierge (Google Gemini & OpenAI) -> [ĐIỀN SECRET TẠI ĐÂY]
# ------------------------------------------------------------------------------
# 🔑 API Key của Google AI Studio (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 🔑 API Key của OpenAI (Dùng cho embeddings text-embedding-3-small hoặc chat fallback)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Cấu hình Jev RAG Pipeline
JEV_EVIDENCE_ENABLED=0
TYPESAFE_API_KEY=
RAG_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
RAG_EMBEDDING_API_KEY=YOUR_OPENAI_API_KEY_HERE
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_CHAT_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
RAG_CHAT_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Phiên bản LLM ghim cứng cho Production (chống silent drift)
RAG_CHAT_MODEL=gemini-1.5-flash-002

# Jev Runtime Intent Router (Pilot)
JEV_ROUTER_ENABLED=0
JEV_API_KEY=
JEV_API_ENDPOINT=https://api.jev.ai/v1/choice
JEV_TIMEOUT_SECONDS=2.0

# ------------------------------------------------------------------------------
# 5. VietQR Payment Gateway (NAPAS 247) -> [ĐIỀN THÔNG TIN TÀI KHOẢN NHẬN TIỀN]
# ------------------------------------------------------------------------------
# Mã BIN ngân hàng (MBBank: 970422, Vietcombank: 970436, VietinBank: 970415, Techcombank: 970407)
VIETQR_BANK_BIN=970422
VIETQR_BANK_NAME=MBBank
# Số tài khoản ngân hàng thực tế của bạn
VIETQR_ACCOUNT_NO=0000000000
# Tên chủ tài khoản (Viết hoa không dấu)
VIETQR_ACCOUNT_NAME=CONG TY TNHH STAR TRAVELS VIET NAM
VIETQR_TEMPLATE=compact2

# Cấu hình đồng bộ sang Frontend
NEXT_PUBLIC_VIETQR_BANK_BIN=970422
NEXT_PUBLIC_VIETQR_BANK_NAME=MBBank
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=0000000000
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=CONG TY TNHH STAR TRAVELS VIET NAM

# ------------------------------------------------------------------------------
# 6. Frontend & Next.js App Router Settings
# ------------------------------------------------------------------------------
# URL của Backend API (Local: http://localhost:8000/api/v1; Prod: https://api.yourdomain.com/api/v1)
BACKEND_URL=http://localhost:8000/api/v1
# URL công khai của trang web khách hàng (Local: http://localhost:3000; Prod: https://startravels.vn)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_LOCAL_ANIMA_ASSETS=0
BFF_ASSISTANT_TIMEOUT_MS=25000
NEXT_OUTPUT_STANDALONE=0

# ------------------------------------------------------------------------------
# 7. Giám sát Lỗi (Sentry APM) & Cảnh báo Telegram -> [TÙY CHỌN]
# ------------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Webhook gửi tin nhắn cảnh báo lỗi khẩn cấp về Telegram (hoặc Discord)
# Cú pháp Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
ALERT_WEBHOOK_URL=
SENTRY_ORG=star-travels
SENTRY_PROJECT=travel-platform
SENTRY_AUTH_TOKEN=
RELEASE_VERSION=star-travels-api@1.0.0

# ------------------------------------------------------------------------------
# 8. Tích hợp Doanh nghiệp Odoo 18 ERP (HMAC Webhooks)
# ------------------------------------------------------------------------------
ODOO_BASE_URL=http://localhost:8069
ODOO_WEBHOOK_SECRET=e7b4c8d9f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8
ODOO_INBOUND_API_KEY=odoo_inbound_sec_key_9876543210fedcba

# ------------------------------------------------------------------------------
# 9. Google Analytics & SEO Webmaster Tools -> [TÙY CHỌN]
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------------------------
# 10. Rate Limiting (DRF Throttling chống Spam API)
# ------------------------------------------------------------------------------
DRF_THROTTLE_ANON=200/day
DRF_THROTTLE_USER=2000/day
DRF_THROTTLE_AUTH=10/minute
DRF_THROTTLE_PAYMENT=30/minute
DRF_THROTTLE_ASSISTANT_CHAT_ANON=15/minute
DRF_THROTTLE_ASSISTANT_CHAT_USER=30/minute

# ------------------------------------------------------------------------------
# 11. Cloudinary Media Storage (Lưu trữ ảnh đám mây không làm nặng Backend)
# ------------------------------------------------------------------------------
# Lấy miễn phí tại: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

