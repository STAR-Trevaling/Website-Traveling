        <mxCell id="rm1" value="1. Click 'Đặt ngay qua Booking.com' / 'Đặt bàn'" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;jumpStyle=arc;jumpSize=6;strokeColor=#0F172A;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="r-trav" target="r-catalog">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rm2" value="2. Mở Modal thông báo chuyển tiếp đối tác chính hãng" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;jumpStyle=arc;jumpSize=6;strokeColor=#0F172A;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="r-catalog" target="r-modal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rm3" value="3. Khách bấm 'Tiếp tục chuyển trang'" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;jumpStyle=arc;jumpSize=6;strokeColor=#0F172A;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="r-trav" target="r-modal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rm4" value="4. navigator.sendBeacon() gửi tracking ngầm không nghẽn" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;jumpStyle=arc;jumpSize=6;strokeColor=#0F172A;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="r-modal" target="r-api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rm5" value="5. Lưu Booking record ('accommodation_referral')" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;jumpStyle=arc;jumpSize=6;strokeColor=#0F172A;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="r-api" target="r-outbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rm6" value="6. Đẩy sự kiện CRM Lead sang Odoo 18 [REFERRAL_LEAD]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;jumpStyle=arc;jumpSize=6;strokeColor=#0F172A;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="r-outbox" target="r-outbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rm7" value="7. Chuyển hướng trình duyệt sang URL đối tác sau 1.5s" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;jumpStyle=arc;jumpSize=6;strokeColor=#0F172A;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="r-modal" target="r-partner">
