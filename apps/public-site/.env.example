# ==============================================================================
# STAR Travels - Public Site Frontend Environment Configuration
# ==============================================================================

# Backend API URL (Local: http://localhost:8000/api/v1; Prod: https://your-backend.koyeb.app/api/v1)
BACKEND_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_LOCAL_ANIMA_ASSETS=0
BFF_ASSISTANT_TIMEOUT_MS=25000

# Cấu hình tài khoản ngân hàng nhận tiền VietQR (NAPAS 247)
NEXT_PUBLIC_VIETQR_BANK_BIN=970422
NEXT_PUBLIC_VIETQR_BANK_NAME=MBBank
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=0000000000
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=CONG TY TNHH STAR TRAVELS VIET NAM

# Giám sát lỗi Sentry APM & Session Replay (Tùy chọn)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_ENVIRONMENT=production

# Google Analytics & Webmaster (Tùy chọn)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
